# ============================================================
#  Normalizacao de fim de linha (o repo e usado em varios PCs)
# ============================================================

# padrao: LF no repositorio
* text=auto eol=lf

# scripts do Windows precisam de CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# binarios: nao mexer
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.xlsx binary
*.pdf binary
